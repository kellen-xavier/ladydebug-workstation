{
  "name": "ladydebug-workstation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "test:browser": "playwright test",
    "test:browser:production": "PLAYWRIGHT_SERVER=production playwright test",
    "dev": "bun --port=3000 scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "preview": "bun run build && bun scripts/preview.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.64.1",
    "@types/bun": "latest",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "mdast-util-from-markdown": "^2.1.0",
    "typescript": "^5",
    "unist-util-visit": "^5.2.0"
  }
}
